        "reporting_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Reporting Currency",
          "type": "string"
        },
        "opening_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Opening Value"
        },
        "terminal_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Terminal Value"
