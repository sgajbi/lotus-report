        "units": {
          "const": "DECIMAL_FRACTION",
          "title": "Units",
          "type": "string"
        },
        "root_precision": {
          "const": "FLOAT64",
          "title": "Root Precision",
          "type": "string"
        },
        "input_money_precision": {
          "const": "EXACT_DECIMAL",
