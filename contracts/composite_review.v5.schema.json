            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
