          "type": "array"
        },
        "excluded_flow_event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Excluded Flow Event Ids",
          "type": "array"
