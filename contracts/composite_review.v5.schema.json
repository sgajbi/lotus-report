        },
        "composite_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Composite Id",
          "type": "string"
        },
        "source_manifest_id": {
          "maxLength": 128,
          "minLength": 1,
