{
  "$defs": {
    "CompositeCell": {
      "additionalProperties": false,
      "properties": {
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonical Value"
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Availability",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reason Codes",
          "type": "array"
        },
        "source_pointer": {
          "pattern": "^/(source_response|selection|report_facts)/",
          "title": "Source Pointer",
          "type": "string"
        }
      },
      "required": [
        "canonical_value",
        "availability",
        "reason_codes",
        "source_pointer"
      ],
      "title": "CompositeCell",
      "type": "object"
    },
    "CompositeRow": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "minLength": 1,
          "title": "Row Id",
          "type": "string"
        },
        "cells": {
          "additionalProperties": {
            "$ref": "#/$defs/CompositeCell"
          },
          "title": "Cells",
          "type": "object"
        }
      },
      "required": [
        "row_id",
        "cells"
      ],
      "title": "CompositeRow",
      "type": "object"
    },
    "CompositeWindowPin": {
      "additionalProperties": false,
      "properties": {
        "materialization_id": {
          "format": "uuid",
          "title": "Materialization Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "restatement_sequence": {
          "minimum": 1,
          "title": "Restatement Sequence",
          "type": "integer"
        },
        "definition_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Content Hash",
          "type": "string"
        },
        "membership_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Membership Content Hash",
          "type": "string"
        },
        "attestation_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attestation Content Hash",
          "type": "string"
        },
        "source_cut_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Cut Id",
          "type": "string"
        },
        "method_binding": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Method Binding",
          "type": "object"
        },
        "retained_receipt_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Retained Receipt Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "materialization_id",
        "period_start",
        "period_end",
        "restatement_sequence",
        "definition_content_hash",
        "membership_content_hash",
        "attestation_content_hash",
        "source_cut_id",
        "method_binding",
        "retained_receipt_fingerprint"
      ],
      "title": "CompositeWindowPin",
      "type": "object"
    },
    "LinkedAnalysisRequest": {
      "additionalProperties": false,
      "description": "Exact registered Performance operation; no client-supplied economics.",
      "properties": {
        "metric_id": {
          "const": "LINKED_MEMBER_CONTRIBUTION",
          "title": "Metric Id",
          "type": "string"
        },
        "method": {
          "const": "CARINO:v1",
          "title": "Method",
          "type": "string"
        },
        "composite_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Composite Id",
          "type": "string"
        },
        "calculation_id": {
          "format": "uuid",
          "title": "Calculation Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "return_view": {
          "enum": [
            "GROSS",
            "NET_ACTUAL",
            "NET_MODEL_FEE"
          ],
          "title": "Return View",
          "type": "string"
        },
        "reporting_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Reporting Currency",
          "type": "string"
        },
        "materialization_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Materialization Ids",
          "type": "array"
        },
        "restatement_sequence": {
          "default": null,
          "description": "Exact vector selection forbids a competing numeric sequence.",
          "title": "Restatement Sequence",
          "type": "null"
        }
      },
      "required": [
        "metric_id",
        "method",
        "composite_id",
        "calculation_id",
        "period_start",
        "period_end",
        "return_view",
        "reporting_currency",
        "materialization_ids"
      ],
      "title": "LinkedAnalysisRequest",
      "type": "object"
    },
    "LinkedAnalysisSelection": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "source_request": {
          "$ref": "#/$defs/LinkedAnalysisRequest"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/CompositeWindowPin"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Windows",
          "type": "array"
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Engine Version",
          "type": "string"
        },
        "calculation_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Calculation Fingerprint",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "source_request",
        "windows",
        "engine_version",
        "calculation_fingerprint",
        "response_digest"
      ],
      "title": "LinkedAnalysisSelection",
      "type": "object"
    },
    "LinkedColumn": {
      "additionalProperties": false,
      "properties": {
        "column_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Column Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value_type": {
          "enum": [
            "TEXT",
            "DECIMAL_RETURN",
            "DECIMAL_FACTOR",
            "MONEY",
            "COUNT"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "unit": {
          "enum": [
            "TEXT",
            "DECIMAL_RATIO",
            "CURRENCY_UNITS",
            "PERIOD_COUNT"
          ],
          "title": "Unit",
          "type": "string"
        },
        "display_unit": {
          "enum": [
            "TEXT",
            "PERCENT",
            "PERCENTAGE_POINTS",
            "DECIMAL_RATIO",
            "CURRENCY_UNITS",
            "PERIOD_COUNT"
          ],
          "title": "Display Unit",
          "type": "string"
        },
        "display_conversion": {
          "enum": [
            "IDENTITY",
            "RATIO_TO_PERCENT_DISPLAY"
          ],
          "title": "Display Conversion",
          "type": "string"
        },
        "display_decimal_places": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Decimal Places"
        },
        "display_rounding_mode": {
          "const": "HALF_UP",
          "title": "Display Rounding Mode",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "scale": {
          "const": "1",
          "title": "Scale",
          "type": "string"
        }
      },
      "required": [
        "column_id",
        "label",
        "value_type",
        "unit",
        "display_unit",
        "display_conversion",
        "display_decimal_places",
        "display_rounding_mode",
        "currency",
        "scale"
      ],
      "title": "LinkedColumn",
      "type": "object"
    },
    "LinkedTable": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "maxLength": 31,
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/LinkedColumn"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CompositeRow"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "table_id",
        "title",
        "columns",
        "rows"
      ],
      "title": "LinkedTable",
      "type": "object"
    },
    "CompositeSelectionManifest": {
      "additionalProperties": true,
      "properties": {
        "qualification": {
          "const": "EXPLICIT_RETAINED_CALCULATED_REPLAY",
          "title": "Qualification",
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/CompositeWindowPin"
          },
          "title": "Windows",
          "type": "array"
        },
        "engine_version": {
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "calculation_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Calculation Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "qualification",
        "windows",
        "engine_version",
        "calculation_fingerprint"
      ],
      "title": "CompositeSelectionManifest",
      "type": "object"
    },
    "LinkedMember": {
      "additionalProperties": true,
      "properties": {
        "portfolio_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "linked_contribution": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Linked Contribution"
        },
        "participating_period_count": {
          "minimum": 1,
          "title": "Participating Period Count",
          "type": "integer"
        }
      },
      "required": [
        "portfolio_id",
        "linked_contribution",
        "participating_period_count"
      ],
      "title": "LinkedMember",
      "type": "object"
    },
    "LinkedPeriod": {
      "additionalProperties": true,
      "properties": {
        "portfolio_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "return_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Return Value"
        },
        "beginning_market_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Beginning Market Value"
        },
        "weight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Weight"
        },
        "contribution": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Contribution"
        },
        "linking_factor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Linking Factor"
        },
        "linked_contribution": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Linked Contribution"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_fingerprint": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "calculation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculation Id"
        },
        "restatement_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Restatement Version",
          "type": "string"
        },
        "restatement_sequence": {
          "minimum": 1,
          "title": "Restatement Sequence",
          "type": "integer"
        },
        "source_authority_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkedSourceAuthority"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "portfolio_id",
        "period_start",
        "period_end",
        "return_value",
        "beginning_market_value",
        "weight",
        "contribution",
        "linking_factor",
        "linked_contribution",
        "source_snapshot_id",
        "source_fingerprint",
        "calculation_id",
        "restatement_version",
        "restatement_sequence",
        "source_authority_identity"
      ],
      "title": "LinkedPeriod",
      "type": "object"
    },
    "LinkedSourceAuthority": {
      "additionalProperties": true,
      "properties": {
        "source_kind": {
          "enum": [
            "INTERNAL",
            "EXTERNAL_PROVIDER",
            "HYBRID"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "return_source_kind": {
          "enum": [
            "LOTUS_PERFORMANCE",
            "EXTERNAL_PROVIDER"
          ],
          "title": "Return Source Kind",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Provider Id",
          "type": "string"
        },
        "source_member_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Member Id",
          "type": "string"
        },
        "product_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Product Name",
          "type": "string"
        },
        "product_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Product Version",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "return_source_kind",
        "provider_id",
        "source_member_id",
        "product_name",
        "product_version",
        "source_revision",
        "source_digest"
      ],
      "title": "LinkedSourceAuthority",
      "type": "object"
    },
    "LinkedAnalysisResponse": {
      "additionalProperties": true,
      "properties": {
        "metric_id": {
          "const": "LINKED_MEMBER_CONTRIBUTION",
          "title": "Metric Id",
          "type": "string"
        },
        "method": {
          "const": "CARINO:v1",
          "title": "Method",
          "type": "string"
        },
        "calculation_id": {
          "format": "uuid",
          "title": "Calculation Id",
          "type": "string"
        },
        "composite_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Composite Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "return_view": {
          "enum": [
            "GROSS",
            "NET_ACTUAL",
            "NET_MODEL_FEE"
          ],
          "title": "Return View",
          "type": "string"
        },
        "reporting_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Reporting Currency",
          "type": "string"
        },
        "status": {
          "const": "CALCULATED_ANALYSIS",
          "title": "Status",
          "type": "string"
        },
        "qualification": {
          "const": "RETAINED_SOURCE_ATTESTATION_NOT_LIVE_QUALIFIED",
          "title": "Qualification",
          "type": "string"
        },
        "units": {
          "const": "DECIMAL_RETURN",
          "title": "Units",
          "type": "string"
        },
        "constituent_decomposition": {
          "const": "AVAILABLE",
          "title": "Constituent Decomposition",
          "type": "string"
        },
        "cumulative_return": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Cumulative Return"
        },
        "total_linked_contribution": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Total Linked Contribution"
        },
        "reconciliation_difference": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Reconciliation Difference"
        },
        "display_rounding_difference": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Display Rounding Difference"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/LinkedMember"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/LinkedPeriod"
          },
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        },
        "selection_manifest": {
          "$ref": "#/$defs/CompositeSelectionManifest"
        }
      },
      "required": [
        "metric_id",
        "method",
        "calculation_id",
        "composite_id",
        "period_start",
        "period_end",
        "return_view",
        "reporting_currency",
        "status",
        "qualification",
        "units",
        "constituent_decomposition",
        "cumulative_return",
        "total_linked_contribution",
        "reconciliation_difference",
        "display_rounding_difference",
        "members",
        "periods",
        "selection_manifest"
      ],
      "title": "LinkedAnalysisResponse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "composite_review.v3",
      "title": "Contract Version",
      "type": "string"
    },
    "qualification": {
      "const": "EXPLICIT_RETAINED_CALCULATED_REPLAY",
      "title": "Qualification",
      "type": "string"
    },
    "publication_state": {
      "const": "NOT_ATTESTED",
      "title": "Publication State",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/LinkedAnalysisSelection"
    },
    "source_response_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Response Digest",
      "type": "string"
    },
    "source_response": {
      "$ref": "#/$defs/LinkedAnalysisResponse"
    },
    "report_facts": {
      "additionalProperties": true,
      "title": "Report Facts",
      "type": "object"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/LinkedTable"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Tables",
      "type": "array"
    }
  },
