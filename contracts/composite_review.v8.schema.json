    "CompositeMemberContribution": {
      "additionalProperties": true,
      "properties": {
        "portfolio_id": {
          "minLength": 1,
          "title": "Portfolio Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "return_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Return Value"
        },
        "beginning_market_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Beginning Market Value"
        },
        "beginning_asset_weight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Beginning Asset Weight"
        },
        "contribution": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Contribution"
        },
        "source_snapshot_id": {
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_fingerprint": {
          "minLength": 1,
          "title": "Source Fingerprint",
          "type": "string"
        },
        "restatement_version": {
          "minLength": 1,
          "title": "Restatement Version",
          "type": "string"
        },
        "restatement_sequence": {
          "minimum": 1,
          "title": "Restatement Sequence",
          "type": "integer"
        },
        "calculation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Id"
        },
        "source_authority_identity": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Authority Identity"
        }
      },
      "required": [
        "portfolio_id",
        "period_start",
        "period_end",
        "return_value",
        "beginning_market_value",
        "beginning_asset_weight",
        "contribution",
        "source_snapshot_id",
        "source_fingerprint",
        "restatement_version",
        "restatement_sequence"
      ],
      "title": "CompositeMemberContribution",
      "type": "object"
    },
    "CompositePeriod": {
      "additionalProperties": true,
      "properties": {
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "status": {
          "enum": [
            "READY",
            "DEGRADED",
            "BLOCKED"
          ],
          "title": "Status",
          "type": "string"
        },
        "return_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return Value"
        },
        "cumulative_return": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cumulative Return"
        },
        "beginning_market_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Beginning Market Value"
        },
        "ending_market_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "title": "Ending Market Value"
        },
