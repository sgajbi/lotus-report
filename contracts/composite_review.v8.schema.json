        },
        "rows": {
          "items": {
            "$ref": "#/$defs/InceptionRow"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "table_id",
        "title",
        "columns",
        "rows"
      ],
      "title": "InceptionTable",
      "type": "object"
    },
    "TrailingReturnSelection": {
