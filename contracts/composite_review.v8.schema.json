{
  "$defs": {
    "CalendarReturnSelection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CALENDAR_RETURN",
          "title": "Kind",
          "type": "string"
        },
        "product_key": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Product Key",
          "type": "string"
        },
        "year": {
          "maximum": 9999,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        },
        "selection": {
          "$ref": "#/$defs/CompositeReportSelection"
        }
      },
      "required": [
        "kind",
        "product_key",
        "year",
        "selection"
      ],
      "title": "CalendarReturnSelection",
      "type": "object"
    },
    "CapturedInceptionDefinition": {
      "additionalProperties": false,
      "properties": {
        "pin": {
          "$ref": "#/$defs/CompositeDefinitionPin"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "method": {
          "const": "GET",
          "title": "Method",
          "type": "string"
        },
        "source_response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Response Digest",
          "type": "string"
        },
        "source_response": {
          "$ref": "#/$defs/InceptionDefinition"
        }
      },
      "required": [
        "pin",
        "endpoint",
        "method",
        "source_response_digest",
        "source_response"
      ],
      "title": "CapturedInceptionDefinition",
      "type": "object"
    },
    "CapturedMembership": {
      "additionalProperties": false,
      "properties": {
        "pin": {
          "$ref": "#/$defs/CompositeMembershipPin"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "method": {
          "const": "GET",
          "title": "Method",
          "type": "string"
        },
        "source_response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Response Digest",
          "type": "string"
        },
        "source_response": {
          "$ref": "#/$defs/EligibilityMembership"
        }
      },
      "required": [
        "pin",
        "endpoint",
        "method",
        "source_response_digest",
        "source_response"
      ],
      "title": "CapturedMembership",
      "type": "object"
    },
    "CapturedReturnProduct": {
      "additionalProperties": false,
      "properties": {
        "pin": {
          "discriminator": {
            "mapping": {
              "CALENDAR_RETURN": "#/$defs/CalendarReturnSelection",
              "TRAILING_RETURN": "#/$defs/TrailingReturnSelection"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CalendarReturnSelection"
            },
            {
              "$ref": "#/$defs/TrailingReturnSelection"
            }
          ],
          "title": "Pin"
        },
        "endpoint": {
          "const": "/composites/twr",
          "title": "Endpoint",
          "type": "string"
        },
        "method": {
          "const": "POST",
          "title": "Method",
          "type": "string"
        },
        "source_response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Response Digest",
          "type": "string"
        },
        "source_response": {
          "$ref": "#/$defs/CompositeCalculatedResponse"
        }
      },
      "required": [
        "pin",
        "endpoint",
        "method",
        "source_response_digest",
        "source_response"
      ],
      "title": "CapturedReturnProduct",
      "type": "object"
    },
    "CompositeColumn": {
      "additionalProperties": false,
      "properties": {
        "column_id": {
          "minLength": 1,
          "title": "Column Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value_type": {
          "enum": [
            "TEXT",
            "DECIMAL_RETURN",
            "MONEY",
            "COUNT"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "unit": {
          "enum": [
            "TEXT",
            "DECIMAL_RATIO",
            "CURRENCY_UNITS",
            "PORTFOLIO_COUNT"
          ],
          "title": "Unit",
          "type": "string"
        },
        "display_unit": {
          "enum": [
            "TEXT",
            "PERCENT",
            "PERCENTAGE_POINTS",
            "CURRENCY_UNITS",
            "PORTFOLIO_COUNT"
          ],
          "title": "Display Unit",
          "type": "string"
        },
        "display_conversion": {
          "enum": [
            "IDENTITY",
            "RATIO_TO_PERCENT_DISPLAY"
          ],
          "title": "Display Conversion",
          "type": "string"
        },
        "display_decimal_places": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Decimal Places"
        },
        "display_rounding_mode": {
          "const": "HALF_UP",
          "default": "HALF_UP",
          "title": "Display Rounding Mode",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "scale": {
          "const": "1",
          "default": "1",
          "title": "Scale",
          "type": "string"
        }
      },
      "required": [
        "column_id",
        "label",
        "value_type",
        "unit",
        "display_unit",
        "display_conversion",
        "display_decimal_places",
        "currency"
      ],
      "title": "CompositeColumn",
      "type": "object"
    },
    "CompositeDefinitionPin": {
      "additionalProperties": false,
      "description": "Exact original Manage v1 definition; the caller cannot supply inception.",
      "properties": {
        "definition_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Definition Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "definition_version",
        "content_hash",
        "response_digest"
      ],
      "title": "CompositeDefinitionPin",
      "type": "object"
    },
    "CompositeMembershipPin": {
      "additionalProperties": false,
      "properties": {
        "membership_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Membership Revision",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "membership_revision",
        "content_hash",
        "response_digest"
      ],
      "title": "CompositeMembershipPin",
      "type": "object"
    },
    "CompositeReportSelection": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "description": "Must match admitted caller tenant; no body authority.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "composite_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Composite Id",
          "type": "string"
        },
        "calculation_id": {
          "format": "uuid",
          "title": "Calculation Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "reporting_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Reporting Currency",
          "type": "string"
        },
        "return_view": {
          "enum": [
            "GROSS",
            "NET_ACTUAL",
            "NET_MODEL_FEE"
          ],
          "title": "Return View",
          "type": "string"
        },
        "methodology": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Methodology",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Engine Version",
          "type": "string"
        },
        "calculation_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Calculation Fingerprint",
          "type": "string"
        },
        "response_digest": {
          "description": "Expected canonical raw response SHA-256, not approval.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/CompositeWindowPin"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Windows",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "composite_id",
        "calculation_id",
        "period_start",
        "period_end",
        "reporting_currency",
        "return_view",
        "methodology",
        "engine_version",
        "calculation_fingerprint",
        "response_digest",
        "windows"
      ],
      "title": "CompositeReportSelection",
      "type": "object"
    },
    "CompositeSourceContextSelection": {
      "additionalProperties": false,
      "description": "Shared definition custody with explicitly selected optional attachments.",
      "properties": {
        "definition": {
          "$ref": "#/$defs/CompositeDefinitionPin"
        },
        "since_inception": {
          "default": false,
          "title": "Since Inception",
          "type": "boolean"
        },
        "memberships": {
          "items": {
            "$ref": "#/$defs/CompositeMembershipPin"
          },
          "maxItems": 2,
          "title": "Memberships",
          "type": "array"
        }
      },
      "required": [
        "definition"
      ],
      "title": "CompositeSourceContextSelection",
      "type": "object"
    },
    "CompositeWindowPin": {
      "additionalProperties": false,
      "properties": {
        "materialization_id": {
          "format": "uuid",
          "title": "Materialization Id",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "restatement_sequence": {
          "minimum": 1,
          "title": "Restatement Sequence",
          "type": "integer"
        },
        "definition_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Content Hash",
          "type": "string"
        },
        "membership_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Membership Content Hash",
          "type": "string"
        },
        "attestation_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attestation Content Hash",
          "type": "string"
        },
        "source_cut_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Cut Id",
          "type": "string"
        },
        "method_binding": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Method Binding",
          "type": "object"
        },
        "retained_receipt_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Retained Receipt Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "materialization_id",
        "period_start",
        "period_end",
        "restatement_sequence",
        "definition_content_hash",
        "membership_content_hash",
        "attestation_content_hash",
        "source_cut_id",
        "method_binding",
        "retained_receipt_fingerprint"
      ],
      "title": "CompositeWindowPin",
      "type": "object"
    },
    "InceptionCell": {
      "additionalProperties": false,
      "properties": {
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonical Value"
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Availability",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reason Codes",
          "type": "array"
        },
        "source_pointer": {
          "pattern": "^/(source_response|selection|report_facts|source_products|definition|supplied_memberships)/",
          "title": "Source Pointer",
          "type": "string"
        }
      },
      "required": [
        "canonical_value",
        "availability",
        "reason_codes",
        "source_pointer"
      ],
      "title": "InceptionCell",
      "type": "object"
    },
    "InceptionRow": {
      "additionalProperties": false,
