          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Product Key",
          "type": "string"
        },
        "months": {
          "maximum": 120,
          "minimum": 1,
          "title": "Months",
          "type": "integer"
        },
        "selection": {
